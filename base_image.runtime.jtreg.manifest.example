# Example runtime manifest for guest-side OpenJDK 11 jtreg bring-up on TOS.
#
# Prefer generating a real manifest automatically:
#   tools/prepare_jtreg_assets.sh
#
# This file remains as a manual template only.

# OpenJDK 11 runtime tree.
@tree /usr/lib/jvm/java-11-openjdk-amd64 = /absolute/path/to/java-11-openjdk-amd64
@tree /etc/java-11-openjdk = /absolute/path/to/etc/java-11-openjdk

# Shared libraries commonly required by the host OpenJDK 11 build.
/lib64/ld-linux-x86-64.so.2 = /absolute/path/to/ld-linux-x86-64.so.2
/lib/x86_64-linux-gnu/libc.so.6 = /absolute/path/to/libc.so.6
/lib/x86_64-linux-gnu/libm.so.6 = /absolute/path/to/libm.so.6
/lib/x86_64-linux-gnu/libz.so.1 = /absolute/path/to/libz.so.1
/lib/x86_64-linux-gnu/libstdc++.so.6 = /absolute/path/to/libstdc++.so.6
/lib/x86_64-linux-gnu/libgcc_s.so.1 = /absolute/path/to/libgcc_s.so.1

# jtreg bundle.
@tree /jdk/jtreg = /absolute/path/to/jtreg

# First-pass OpenJDK 11 test payload.
@tree /jdk/test/jdk = /absolute/path/to/openjdk/test/jdk
@tree /jdk/test/lib = /absolute/path/to/openjdk/test/lib
@tree /jdk/test/jtreg-ext = /absolute/path/to/openjdk/test/jtreg-ext
