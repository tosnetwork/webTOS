# Base-image payload manifest
#
# Format:
#   /tos/absolute/path = relative/or/absolute/host/path
#   @tree /tos/prefix = relative/or/absolute/host/directory
#
# These files are embedded at build time and installed into the shared
# base-image keyspace by the root agent during boot.
#
# Keep runtime payloads here instead of hardcoding individual include_bytes!
# calls in kernel source. Large or host-specific runtime payload sets can be
# emitted into `base_image.runtime.manifest`, which is loaded automatically
# when present.

/lib/ld-musl-x86_64.so.1 = test_data/musl_libc.so
/usr/bin/hello_dynamic = test_data/hello_dynamic.elf
/usr/lib/tos-tests/Hello.class = test_data/Hello.class
/usr/lib/tos-tests/FsProbe.class = test_data/FsProbe.class
/usr/lib/tos-tests/JavaChildSmoke.class = test_data/JavaChildSmoke.class
/usr/lib/tos-tests/JavaThreadSmoke.class = test_data/JavaThreadSmoke.class
/usr/lib/tos-tests/JavaAnnotationDeadlockProbe.class = test_data/JavaAnnotationDeadlockProbe.class
/usr/lib/tos-tests/JavaAnnotationDeadlockProbe$AnnA.class = test_data/JavaAnnotationDeadlockProbe$AnnA.class
/usr/lib/tos-tests/JavaAnnotationDeadlockProbe$AnnB.class = test_data/JavaAnnotationDeadlockProbe$AnnB.class
/usr/lib/tos-tests/JavaAnnotationDeadlockProbe$Task.class = test_data/JavaAnnotationDeadlockProbe$Task.class
/usr/lib/tos-tests/java-smoke.jar = test_data/java-smoke.jar
/usr/lib/tos-tests/python_child_smoke.py = test_data/python_child_smoke.py
/usr/lib/tos-tests/node_child_smoke.js = test_data/node_child_smoke.js
/usr/lib/tos-tests/node_thread_smoke.js = test_data/node_thread_smoke.js
/usr/lib/tos-tests/payload.txt = test_data/payload.txt
